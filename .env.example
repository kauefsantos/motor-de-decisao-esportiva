SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Google OAuth (used by local Supabase config; configure the cloud provider in
# Supabase Authentication > Providers > Google with the same credentials).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=""

# Server-only secrets. Never prefix with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=""
FIVE_DOLLAR_FOOTBALL_API_KEY=""
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
